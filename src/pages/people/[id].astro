---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import ConceptCard from '../../components/ConceptCard.astro';
import ReviewBadge from '../../components/ReviewBadge.astro';
import SourceList from '../../components/SourceList.astro';
import { loadAtlas } from '../../lib/atlas';
import {
  eraLabel, fieldLabel, themeLabel, regionLabel,
  relationLabel, relationHint, formatLifespan,
} from '../../lib/vocab';

export async function getStaticPaths() {
  const people = await getCollection('people');
  return people.map((person) => ({ params: { id: person.id }, props: { person } }));
}

const { person } = Astro.props;
const d = person.data;
const { Content } = await render(person);
const atlas = await loadAtlas();

const works = atlas.personWorks.get(person.id) ?? [];
const concepts = atlas.personConcepts.get(person.id) ?? [];
const events = atlas.personEvents.get(person.id) ?? [];
const topics = atlas.personTopics.get(person.id) ?? [];
const routes = atlas.personRoutes.get(person.id) ?? [];

// この人物が挙げている関係（outbound）と、この人物を挙げている関係（inbound）
const outbound = d.relatedPeople
  .map((l) => ({ ...l, person: atlas.peopleById.get(l.id) }))
  .filter((l) => l.person);
const inbound = (atlas.inboundPeople.get(person.id) ?? []).filter(
  (l) => !d.relatedPeople.some((o) => o.id === l.from.id),
);

const idx = atlas.people.findIndex((p) => p.id === person.id);
const prev = atlas.people[idx - 1];
const next = atlas.people[idx + 1];
---

<Base title={d.nameJa} description={d.summary}>
  <article>
    <div class="wrap">
      <p class="breadcrumb"><a href="/people">人物</a> ／ {eraLabel[d.era]}</p>
    </div>

    <header class="wrap-text section" style="padding-bottom:1.8rem">
      <p class="eyebrow">
        <span class="era-dot" style={`--era: var(--era-${d.era})`}></span>{eraLabel[d.era]}
      </p>
      <h1 style="margin-bottom:.25rem">{d.nameJa}</h1>
      <p style="color:var(--muted);font-family:var(--font-serif);font-size:1.05rem;margin-bottom:1.2rem">
        {d.nameEn}{d.nameOriginal ? `（${d.nameOriginal}）` : ''}
        <span style="opacity:.6"> ・ </span>{formatLifespan(d.birth, d.death, d.lifespanLabel)}
      </p>

      <p style="font-family:var(--font-serif);font-size:clamp(1.05rem,1rem + .5vw,1.3rem);line-height:1.8;max-width:44rem;color:var(--ink)">
        {d.summary}
      </p>

      <ul class="tags" style="margin-top:1.2rem">
        {d.country && <li class="tag">{d.country}</li>}
        <li class="tag">{regionLabel[d.region]}</li>
        {d.fields.map((f) => <li class="tag">{fieldLabel[f]}</li>)}
        {d.themes.map((t) => <li class="tag">{themeLabel[t]}</li>)}
      </ul>
      {d.keywords.length > 0 && (
        <ul class="tags" style="margin-top:.5rem">
          {d.keywords.map((k) => <li class="tag">#{k}</li>)}
        </ul>
      )}
    </header>

    <div class="wrap-text article-body">
      <div class="prose">
        <Content />
      </div>
    </div>

    {works.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head"><h2>代表的な著作</h2></div>
          <div class="grid grid-cards">
            {works.map((w) => <WorkCard work={w} />)}
          </div>
        </div>
      </section>
    )}

    {concepts.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <h2>重要概念</h2>
            <p>この人物に結びつく概念。概念ページからは、同じ概念を共有する他の人物へ辿れる。</p>
          </div>
          <div class="grid grid-cards">
            {concepts.map((c) => <ConceptCard concept={c} />)}
          </div>
        </div>
      </section>
    )}

    {(outbound.length > 0 || inbound.length > 0) && (
      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <h2>思想のつながり</h2>
            <p>「歴史的に直接影響した」のか「後から見ると似た問題を扱っている」のかを区別して記述している。</p>
          </div>
          <div class="grid grid-wide">
            {outbound.map((l) => (
              <a class="card" href={`/people/${l.person!.id}`}>
                <p class="card__meta">
                  {relationLabel[l.relation]}
                  <span style="opacity:.55"> ・ 確度 {l.confidence}</span>
                </p>
                <h3 class="card__title">{l.person!.data.nameJa}</h3>
                <p class="card__sub">{relationHint[l.relation]}</p>
                {l.note && <p class="card__body">{l.note}</p>}
              </a>
            ))}
            {inbound.map((l) => (
              <a class="card" href={`/people/${l.from.id}`}>
                <p class="card__meta">
                  {l.from.data.nameJa}からの{relationLabel[l.relation]}
                  <span style="opacity:.55"> ・ 確度 {l.confidence}</span>
                </p>
                <h3 class="card__title">{l.from.data.nameJa}</h3>
                <p class="card__sub">{relationHint[l.relation]}</p>
                {l.note && <p class="card__body">{l.note}</p>}
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {(d.modernLinks.length > 0 || events.length > 0) && (
      <section class="section">
        <div class="wrap">
          <div class="section-head"><h2>現代科学との接続</h2></div>
          {d.modernLinks.length > 0 && (
            <ul style="margin:0 0 1.4rem;padding-left:1.2em;font-size:.95rem">
              {d.modernLinks.map((m) => <li>{m}</li>)}
            </ul>
          )}
          {events.length > 0 && (
            <ul class="link-list">
              {events.map((e) => (
                <li>
                  <a href={`/history#event-${e.id}`}>
                    <span class="lead">{e.data.title}</span>
                    <span class="trail">{e.data.yearLabel ?? e.data.year}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )}

    {(topics.length > 0 || routes.length > 0) && (
      <section class="section">
        <div class="wrap">
          <div class="section-head"><h2>この人物から辿る</h2></div>
          <ul class="tags">
            {routes.map((r) => <li><a class="tag" href={`/connections#route-${r.id}`}>系譜：{r.data.title}</a></li>)}
            {topics.map((t) => <li><a class="tag" href={`/topics/${t.id}`}>テーマ：{t.data.title}</a></li>)}
          </ul>
        </div>
      </section>
    )}

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2>原典と参考文献</h2>
          <p>本文の記述がどこまで辿れるかを示すための一覧。</p>
        </div>
        <SourceList sources={d.sources} />
        <p style="margin-top:1.5rem"><ReviewBadge status={d.reviewStatus} lastReviewed={d.lastReviewed} /></p>
        {d.reviewStatus !== 'reviewed' && (
          <p class="note" style="margin-top:1rem">
            このページはまだ人手による最終確認を経ていません。年代・引用・帰属については、上記の一次資料・二次資料に当たって確認してください。
          </p>
        )}
      </div>
    </section>

    <nav class="wrap section" style="border-top:1px solid var(--line)">
      <div style="display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:.9rem">
        {prev ? <a href={`/people/${prev.id}`}>← {prev.data.nameJa}</a> : <span></span>}
        {next ? <a href={`/people/${next.id}`}>{next.data.nameJa} →</a> : <span></span>}
      </div>
    </nav>
  </article>
</Base>
